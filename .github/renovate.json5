{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':rebaseStalePrs',
    ':prConcurrentLimit10',
  ],
  labels: [
    'dependencies',
    'renovate',
  ],
  enabledManagers: [
    'cargo',
    'github-actions',
  ],
  timezone: 'UTC',
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on monday'],
  },
  // Let Renovate merge itself once the CI checks pass, rather than relying on
  // GitHub's native auto-merge.
  platformAutomerge: false,
  packageRules: [
    {
      // Keep GitHub Actions pinned to immutable commits.
      matchManagers: ['github-actions'],
      pinDigests: true,
    },
    {
      // Only patch updates are safe to merge without review; minor and major
      // updates stay as normal PRs.
      matchUpdateTypes: ['patch'],
      automerge: true,
      // Rebasing on every base-branch change restarts CI and makes patch
      // updates merge one per Renovate run. Only rebase when necessary.
      rebaseWhen: 'conflicted',
      // Give new releases a short cooling-off period before automerging.
      minimumReleaseAge: '3 days',
    },
  ],
}
